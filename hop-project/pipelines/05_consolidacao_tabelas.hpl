<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>05_consolidacao_tabelas</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Cruzamento e consolidacao das 3 tabelas normalizadas com notas</description>
    <pipeline_type>Normal</pipeline_type>
  </info>
  <order>
    <hop><from>Carregar Dimensoes</from><to>Gerar students_grade_performance_sleep</to><enabled>Y</enabled></hop>
    <hop><from>Carregar Dimensoes</from><to>Gerar students_grade_performance_habits</to><enabled>Y</enabled></hop>
    <hop><from>Carregar Dimensoes</from><to>Gerar students_grade_performance_mental_health</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Carregar Dimensoes</name>
    <type>TableInput</type>
    <connection>sqlite_estudantes</connection>
    <sql>SELECT 1</sql>
  </transform>
  <transform>
    <name>Gerar students_grade_performance_sleep</name>
    <type>TableOutput</type>
    <connection>sqlite_estudantes</connection>
    <table>students_grade_performance_sleep</table><truncate>Y</truncate>
  </transform>
  <transform>
    <name>Gerar students_grade_performance_habits</name>
    <type>TableOutput</type>
    <connection>sqlite_estudantes</connection>
    <table>students_grade_performance_habits</table><truncate>Y</truncate>
  </transform>
  <transform>
    <name>Gerar students_grade_performance_mental_health</name>
    <type>TableOutput</type>
    <connection>sqlite_estudantes</connection>
    <table>students_grade_performance_mental_health</table><truncate>Y</truncate>
  </transform>
</pipeline>
