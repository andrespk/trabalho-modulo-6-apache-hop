<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>05_consolidacao_tabelas</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Consolidação Gold das 3 Tabelas Analíticas</description>
    <pipeline_type>Normal</pipeline_type>
  </info>
  <order>
    <hop><from>Gerar students_grade_performance_sleep</from><to>Gravar Gold Sleep</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Gerar students_grade_performance_sleep</name>
    <type>TableInput</type>
    <connection>sqlite_estudantes</connection>
    <sql>SELECT id_aluno, genero, idade, horas_estudo, nota_anterior, horas_sono, eficiencia_media, perc_sono_profundo_estimado, despertares_noite_estimados, iqs_estimado, classificacao_sono_estimada, score_geral_ponderado, 'CARGA_HOP_GOLD' as dt_carga FROM students_grade_performance_sleep</sql>
  </transform>
  <transform>
    <name>Gravar Gold Sleep</name>
    <type>Dummy</type>
  </transform>
</pipeline>
