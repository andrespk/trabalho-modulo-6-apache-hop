<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>02_transform_silver_dims</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Tratamento, Limpeza e Carga das Dimensoes Silver</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
  </info>
  <order>
    <hop>
      <from>Ler raw_sleep_efficiency</from>
      <to>Tratar Nulos e IQS</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Tratar Nulos e IQS</from>
      <to>Gravar dim_sono</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ler raw_student_performance</from>
      <to>Padronizar dim_alunos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Padronizar dim_alunos</from>
      <to>Gravar dim_alunos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ler raw_student_habits</from>
      <to>Calcular Telas e SQD</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Calcular Telas e SQD</from>
      <to>Gravar dim_habitos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ler raw_student_mental_health</from>
      <to>Limpar Flags Mental</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Limpar Flags Mental</from>
      <to>Gravar dim_saude_mental</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  
  <transform>
    <name>Ler raw_sleep_efficiency</name>
    <type>TableInput</type>
    <connection>sqlite_estudantes</connection>
    <sql>SELECT * FROM raw_sleep_efficiency;</sql>
  </transform>
  <transform>
    <name>Tratar Nulos e IQS</name>
    <type>SelectValues</type>
  </transform>
  <transform>
    <name>Gravar dim_sono</name>
    <type>TableOutput</type>
    <connection>sqlite_estudantes</connection>
    <table>dim_sono</table>
    <truncate>Y</truncate>
    <commit>1000</commit>
  </transform>

  <transform>
    <name>Ler raw_student_performance</name>
    <type>TableInput</type>
    <connection>sqlite_estudantes</connection>
    <sql>SELECT * FROM raw_student_performance;</sql>
  </transform>
  <transform>
    <name>Padronizar dim_alunos</name>
    <type>SelectValues</type>
  </transform>
  <transform>
    <name>Gravar dim_alunos</name>
    <type>TableOutput</type>
    <connection>sqlite_estudantes</connection>
    <table>dim_alunos</table>
    <truncate>Y</truncate>
    <commit>1000</commit>
  </transform>

  <transform>
    <name>Ler raw_student_habits</name>
    <type>TableInput</type>
    <connection>sqlite_estudantes</connection>
    <sql>SELECT * FROM raw_student_habits;</sql>
  </transform>
  <transform>
    <name>Calcular Telas e SQD</name>
    <type>Calculator</type>
  </transform>
  <transform>
    <name>Gravar dim_habitos</name>
    <type>TableOutput</type>
    <connection>sqlite_estudantes</connection>
    <table>dim_habitos</table>
    <truncate>Y</truncate>
    <commit>1000</commit>
  </transform>

  <transform>
    <name>Ler raw_student_mental_health</name>
    <type>TableInput</type>
    <connection>sqlite_estudantes</connection>
    <sql>SELECT * FROM raw_student_mental_health;</sql>
  </transform>
  <transform>
    <name>Limpar Flags Mental</name>
    <type>SelectValues</type>
  </transform>
  <transform>
    <name>Gravar dim_saude_mental</name>
    <type>TableOutput</type>
    <connection>sqlite_estudantes</connection>
    <table>dim_saude_mental</table>
    <truncate>Y</truncate>
    <commit>1000</commit>
  </transform>
</pipeline>
