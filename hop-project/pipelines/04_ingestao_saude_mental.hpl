<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>04_ingestao_saude_mental</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Pipeline de ingestao e tratamento de dados de saude mental</description>
    <pipeline_type>Normal</pipeline_type>
  </info>
  <order>
    <hop><from>Ler Student Mental health.csv</from><to>Padronizar Diagnosticos</to><enabled>Y</enabled></hop>
    <hop><from>Padronizar Diagnosticos</from><to>Converter Faixa CGPA para Nota</to><enabled>Y</enabled></hop>
    <hop><from>Converter Faixa CGPA para Nota</from><to>Gravar dim_saude_mental SQLite</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Ler Student Mental health.csv</name>
    <type>CsvInput</type>
    <filename>${PROJECT_HOME}/../database/Student Mental health.csv</filename>
    <separator>,</separator><enclosure>"</enclosure><header>Y</header>
  </transform>
  <transform><name>Padronizar Diagnosticos</name><type>SelectValues</type></transform>
  <transform><name>Converter Faixa CGPA para Nota</name><type>Calculator</type></transform>
  <transform>
    <name>Gravar dim_saude_mental SQLite</name>
    <type>TableOutput</type>
    <connection>sqlite_estudantes</connection>
    <table>dim_saude_mental</table><truncate>Y</truncate>
  </transform>
</pipeline>
