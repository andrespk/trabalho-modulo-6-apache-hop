<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>03_consolidacao_cruzada</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Pipeline de consolidacao e cruzamento de dados</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/26 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/26 12:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop>
      <from>Carregar dim_alunos</from>
      <to>Join com dim_sono</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Carregar dim_sono</from>
      <to>Join com dim_sono</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Join com dim_sono</from>
      <to>Calcular Score Combinado</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Calcular Score Combinado</from>
      <to>Gravar students_performance_sleep</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Carregar dim_alunos</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>sqlite_estudantes</connection>
    <sql>SELECT * FROM dim_alunos</sql>
    <limit>0</limit>
    <attributes/>
  </transform>
  <transform>
    <name>Carregar dim_sono</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>sqlite_estudantes</connection>
    <sql>SELECT * FROM dim_sono</sql>
    <limit>0</limit>
    <attributes/>
  </transform>
  <transform>
    <name>Join com dim_sono</name>
    <type>MergeJoin</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <join_type>LEFT OUTER</join_type>
    <attributes/>
  </transform>
  <transform>
    <name>Calcular Score Combinado</name>
    <type>Calculator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <name>Gravar students_performance_sleep</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>sqlite_estudantes</connection>
    <schema/>
    <table>students_performance_sleep</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <attributes/>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>
