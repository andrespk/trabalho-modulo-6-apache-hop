<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>01_ingestao_sono</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Pipeline de ingestao e tratamento dos dados de sono</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/26 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/26 12:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop>
      <from>Ler CSV Sleep_Efficiency</from>
      <to>Tratar Nulos e Padronizar</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Tratar Nulos e Padronizar</from>
      <to>Calcular IQS e Categorias</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Calcular IQS e Categorias</from>
      <to>Gravar dim_sono SQLite</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Ler CSV Sleep_Efficiency</name>
    <type>CSVFileInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${PROJECT_HOME}/../database/Sleep_Efficiency.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field><name>ID</name><type>Integer</type><format>#</format></field>
      <field><name>Age</name><type>Integer</type><format>#</format></field>
      <field><name>Gender</name><type>String</type><format/></field>
      <field><name>Bedtime</name><type>String</type><format/></field>
      <field><name>Wakeup time</name><type>String</type><format/></field>
      <field><name>Sleep duration</name><type>Number</type><format>#.#</format></field>
      <field><name>Sleep efficiency</name><type>Number</type><format>#.#</format></field>
      <field><name>REM sleep percentage</name><type>Number</type><format>#</format></field>
      <field><name>Deep sleep percentage</name><type>Number</type><format>#</format></field>
      <field><name>Light sleep percentage</name><type>Number</type><format>#</format></field>
      <field><name>Awakenings</name><type>Number</type><format>#.#</format></field>
      <field><name>Caffeine consumption</name><type>Number</type><format>#.#</format></field>
      <field><name>Alcohol consumption</name><type>Number</type><format>#.#</format></field>
      <field><name>Smoking status</name><type>String</type><format/></field>
      <field><name>Exercise frequency</name><type>Number</type><format>#.#</format></field>
    </fields>
    <attributes/>
  </transform>
  <transform>
    <name>Tratar Nulos e Padronizar</name>
    <type>ValueMeta</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <name>Calcular IQS e Categorias</name>
    <type>Calculator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <name>Gravar dim_sono SQLite</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>sqlite_estudantes</connection>
    <schema/>
    <table>dim_sono</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <attributes/>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>
