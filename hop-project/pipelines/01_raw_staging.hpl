<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>01_raw_staging</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Ingestao Concorrente das 3 Bases de Dados para a Camada Raw Bronze Staging</description>
    <extended_description>Pipeline de alta performance com leitura paralela de 3 CSVs e gravacao direta nas tabelas raw do SQLite</extended_description>
    <pipeline_version>2.0</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
  </info>
  <order>
    <hop><from>Ler Sleep Efficiency CSV</from><to>Add Meta Sleep</to><enabled>Y</enabled></hop>
    <hop><from>Add Meta Sleep</from><to>Map Sleep Orig</to><enabled>Y</enabled></hop>
    <hop><from>Map Sleep Orig</from><to>Gravar raw_sleep_efficiency</to><enabled>Y</enabled></hop>
    
    <hop><from>Ler Student Habits CSV</from><to>Add Meta Habits</to><enabled>Y</enabled></hop>
    <hop><from>Add Meta Habits</from><to>Map Habits Orig</to><enabled>Y</enabled></hop>
    <hop><from>Map Habits Orig</from><to>Gravar raw_student_habits</to><enabled>Y</enabled></hop>
    
    <hop><from>Ler Mental Health CSV</from><to>Add Meta Mental</to><enabled>Y</enabled></hop>
    <hop><from>Add Meta Mental</from><to>Map Mental Orig</to><enabled>Y</enabled></hop>
    <hop><from>Map Mental Orig</from><to>Gravar raw_student_mental_health</to><enabled>Y</enabled></hop>
  </order>

  <!-- 1. Sleep Efficiency -->
  <transform>
    <name>Ler Sleep Efficiency CSV</name><type>CsvInput</type>
    <filename>${PROJECT_HOME}/../database/Sleep_Efficiency.csv</filename>
    <separator>,</separator><enclosure>"</enclosure><header>Y</header><buffer_size>50000</buffer_size><encoding>UTF-8</encoding>
    <fields>
      <field><name>ID</name><type>String</type></field><field><name>Age</name><type>String</type></field><field><name>Gender</name><type>String</type></field>
      <field><name>Bedtime</name><type>String</type></field><field><name>Wakeup time</name><type>String</type></field><field><name>Sleep duration</name><type>String</type></field>
      <field><name>Sleep efficiency</name><type>String</type></field><field><name>REM sleep percentage</name><type>String</type></field><field><name>Deep sleep percentage</name><type>String</type></field>
      <field><name>Light sleep percentage</name><type>String</type></field><field><name>Awakenings</name><type>String</type></field><field><name>Caffeine consumption</name><type>String</type></field>
      <field><name>Alcohol consumption</name><type>String</type></field><field><name>Smoking status</name><type>String</type></field><field><name>Exercise frequency</name><type>String</type></field>
    </fields>
  </transform>
  <transform>
    <name>Add Meta Sleep</name><type>Constant</type>
    <fields>
      <field><name>_loaded_at</name><type>String</type><nullif>2026-08-26 12:00:00</nullif></field>
      <field><name>_source_file</name><type>String</type><nullif>Sleep_Efficiency.csv</nullif></field>
    </fields>
  </transform>
  <transform>
    <name>Map Sleep Orig</name><type>SelectValues</type>
    <fields>
      <field><name>ID</name><rename>id_orig</rename></field><field><name>Age</name><rename>age_orig</rename></field><field><name>Gender</name><rename>gender_orig</rename></field>
      <field><name>Bedtime</name><rename>bedtime_orig</rename></field><field><name>Wakeup time</name><rename>wakeup_time_orig</rename></field><field><name>Sleep duration</name><rename>sleep_duration_orig</rename></field>
      <field><name>Sleep efficiency</name><rename>sleep_efficiency_orig</rename></field><field><name>REM sleep percentage</name><rename>rem_sleep_percentage_orig</rename></field><field><name>Deep sleep percentage</name><rename>deep_sleep_percentage_orig</rename></field>
      <field><name>Light sleep percentage</name><rename>light_sleep_percentage_orig</rename></field><field><name>Awakenings</name><rename>awakenings_orig</rename></field><field><name>Caffeine consumption</name><rename>caffeine_consumption_orig</rename></field>
      <field><name>Alcohol consumption</name><rename>alcohol_consumption_orig</rename></field><field><name>Smoking status</name><rename>smoking_status_orig</rename></field><field><name>Exercise frequency</name><rename>exercise_frequency_orig</rename></field>
      <field><name>_loaded_at</name></field><field><name>_source_file</name></field>
      <select_unspecified>N</select_unspecified>
    </fields>
  </transform>
  <transform>
    <name>Gravar raw_sleep_efficiency</name><type>TableOutput</type>
    <connection>sqlite_estudantes</connection><table>raw_sleep_efficiency</table><truncate>Y</truncate><specify_fields>N</specify_fields><commit>1000</commit>
  </transform>

  <!-- 2. Habits (Todas as 16 colunas posicionais do CSV) -->
  <transform>
    <name>Ler Student Habits CSV</name><type>CsvInput</type>
    <filename>${PROJECT_HOME}/../database/student_habits_performance.csv</filename>
    <separator>,</separator><enclosure>"</enclosure><header>Y</header><buffer_size>50000</buffer_size><encoding>UTF-8</encoding>
    <fields>
      <field><name>student_id</name><type>String</type></field>
      <field><name>age</name><type>String</type></field>
      <field><name>gender</name><type>String</type></field>
      <field><name>study_hours_per_day</name><type>String</type></field>
      <field><name>social_media_hours</name><type>String</type></field>
      <field><name>netflix_hours</name><type>String</type></field>
      <field><name>part_time_job</name><type>String</type></field>
      <field><name>attendance_percentage</name><type>String</type></field>
      <field><name>sleep_hours</name><type>String</type></field>
      <field><name>diet_quality</name><type>String</type></field>
      <field><name>exercise_frequency</name><type>String</type></field>
      <field><name>parental_education_level</name><type>String</type></field>
      <field><name>internet_quality</name><type>String</type></field>
      <field><name>mental_health_rating</name><type>String</type></field>
      <field><name>extracurricular_participation</name><type>String</type></field>
      <field><name>exam_score</name><type>String</type></field>
    </fields>
  </transform>
  <transform>
    <name>Add Meta Habits</name><type>Constant</type>
    <fields>
      <field><name>_loaded_at</name><type>String</type><nullif>2026-08-26 12:00:00</nullif></field>
      <field><name>_source_file</name><type>String</type><nullif>student_habits_performance.csv</nullif></field>
    </fields>
  </transform>
  <transform>
    <name>Map Habits Orig</name><type>SelectValues</type>
    <fields>
      <field><name>student_id</name><rename>student_id_orig</rename></field>
      <field><name>age</name><rename>age_orig</rename></field>
      <field><name>gender</name><rename>gender_orig</rename></field>
      <field><name>study_hours_per_day</name><rename>study_hours_per_day_orig</rename></field>
      <field><name>social_media_hours</name><rename>social_media_hours_orig</rename></field>
      <field><name>netflix_hours</name><rename>netflix_hours_orig</rename></field>
      <field><name>part_time_job</name><rename>part_time_job_orig</rename></field>
      <field><name>attendance_percentage</name><rename>attendance_percentage_orig</rename></field>
      <field><name>sleep_hours</name><rename>sleep_hours_orig</rename></field>
      <field><name>diet_quality</name><rename>diet_quality_orig</rename></field>
      <field><name>exercise_frequency</name><rename>exercise_frequency_orig</rename></field>
      <field><name>parental_education_level</name><rename>parental_education_level_orig</rename></field>
      <field><name>internet_quality</name><rename>internet_quality_orig</rename></field>
      <field><name>mental_health_rating</name><rename>mental_health_rating_orig</rename></field>
      <field><name>extracurricular_participation</name><rename>extracurricular_participation_orig</rename></field>
      <field><name>exam_score</name><rename>exam_score_orig</rename></field>
      <field><name>_loaded_at</name></field>
      <field><name>_source_file</name></field>
      <select_unspecified>N</select_unspecified>
    </fields>
  </transform>
  <transform>
    <name>Gravar raw_student_habits</name><type>TableOutput</type>
    <connection>sqlite_estudantes</connection><table>raw_student_habits</table><truncate>Y</truncate><specify_fields>N</specify_fields><commit>1000</commit>
  </transform>

  <!-- 3. Mental Health -->
  <transform>
    <name>Ler Mental Health CSV</name><type>CsvInput</type>
    <filename>${PROJECT_HOME}/../database/Student Mental health.csv</filename>
    <separator>,</separator><enclosure>"</enclosure><header>Y</header><buffer_size>50000</buffer_size><encoding>UTF-8</encoding>
    <fields>
      <field><name>Timestamp</name><type>String</type></field><field><name>Choose your gender</name><type>String</type></field><field><name>Age</name><type>String</type></field>
      <field><name>What is your course?</name><type>String</type></field><field><name>Your current year of Study</name><type>String</type></field><field><name>What is your CGPA?</name><type>String</type></field>
      <field><name>Marital status</name><type>String</type></field><field><name>Do you have Depression?</name><type>String</type></field><field><name>Do you have Anxiety?</name><type>String</type></field>
      <field><name>Do you have Panic attack?</name><type>String</type></field><field><name>Did you seek any specialist treatment?</name><type>String</type></field>
    </fields>
  </transform>
  <transform>
    <name>Add Meta Mental</name><type>Constant</type>
    <fields>
      <field><name>_loaded_at</name><type>String</type><nullif>2026-08-26 12:00:00</nullif></field>
      <field><name>_source_file</name><type>String</type><nullif>Student Mental health.csv</nullif></field>
    </fields>
  </transform>
  <transform>
    <name>Map Mental Orig</name><type>SelectValues</type>
    <fields>
      <field><name>Timestamp</name><rename>timestamp_orig</rename></field><field><name>Choose your gender</name><rename>gender_orig</rename></field><field><name>Age</name><rename>age_orig</rename></field>
      <field><name>What is your course?</name><rename>course_orig</rename></field><field><name>Your current year of Study</name><rename>year_of_study_orig</rename></field><field><name>What is your CGPA?</name><rename>cgpa_orig</rename></field>
      <field><name>Marital status</name><rename>marital_status_orig</rename></field><field><name>Do you have Depression?</name><rename>depression_orig</rename></field><field><name>Do you have Anxiety?</name><rename>anxiety_orig</rename></field>
      <field><name>Do you have Panic attack?</name><rename>panic_attack_orig</rename></field><field><name>Did you seek any specialist treatment?</name><rename>treatment_orig</rename></field>
      <field><name>_loaded_at</name></field><field><name>_source_file</name></field>
      <select_unspecified>N</select_unspecified>
    </fields>
  </transform>
  <transform>
    <name>Gravar raw_student_mental_health</name><type>TableOutput</type>
    <connection>sqlite_estudantes</connection><table>raw_student_mental_health</table><truncate>Y</truncate><specify_fields>N</specify_fields><commit>1000</commit>
  </transform>
</pipeline>
