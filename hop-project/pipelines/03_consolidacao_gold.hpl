<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>03_consolidacao_gold</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Consolidacao das 3 Tabelas Gold</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
  </info>
  <order>
    <hop>
      <from>Consolidar Gold Sleep SQL</from>
      <to>Gravar students_grade_performance_sleep</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Consolidar Gold Habits SQL</from>
      <to>Gravar students_grade_performance_habits</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Consolidar Gold Mental SQL</from>
      <to>Gravar students_grade_performance_mental_health</to>
      <enabled>Y</enabled>
    </hop>
  </order>

  <transform>
    <name>Consolidar Gold Sleep SQL</name>
    <type>TableInput</type>
    <connection>sqlite_estudantes</connection>
    <sql>SELECT 
      a.id_aluno AS id_registro,
      a.id_aluno,
      s.id_sono,
      a.genero,
      a.horas_estudo,
      a.frequencia_escolar,
      a.nota_anterior,
      a.nota_exame,
      s.duracao_sono_horas,
      s.eficiencia_sono,
      s.perc_profundo,
      s.perc_rem,
      s.despertares,
      s.indice_qualidade_sono AS iqs_estimado,
      s.classificacao_sono AS classificacao_sono_estimada,
      ROUND(a.nota_exame / NULLIF(a.horas_estudo, 0), 2) AS roi_estudo,
      CASE 
        WHEN s.duracao_sono_horas &lt; 6.0 AND a.trabalho_parcial = 'Yes' THEN 'Crítico'
        WHEN s.duracao_sono_horas &lt; 6.5 OR a.horas_estudo &gt; 5.0 THEN 'Alto Risco'
        WHEN s.duracao_sono_horas &gt;= 7.0 AND a.frequencia_escolar &gt;= 80 THEN 'Baixo Risco'
        ELSE 'Moderado'
      END AS nivel_risco_estimado,
      datetime('now') AS _created_at
    FROM dim_alunos a
    LEFT JOIN dim_sono s ON ((a.id_aluno - 1) % (SELECT COUNT(*) FROM dim_sono) + 1) = s.id_sono;</sql>
  </transform>
  <transform>
    <name>Gravar students_grade_performance_sleep</name>
    <type>TableOutput</type>
    <connection>sqlite_estudantes</connection>
    <table>students_grade_performance_sleep</table>
    <truncate>Y</truncate>
    <commit>1000</commit>
  </transform>

  <transform>
    <name>Consolidar Gold Habits SQL</name>
    <type>TableInput</type>
    <connection>sqlite_estudantes</connection>
    <sql>SELECT 
      h.id_habito AS id_estudante_habito,
      h.id_habito,
      h.idade,
      h.genero,
      h.horas_estudo_dia,
      h.tempo_redes_sociais,
      h.tempo_netflix,
      h.tempo_telas_horas,
      h.faixa_telas,
      h.qualidade_dieta,
      h.freq_exercicio,
      h.score_saude_mental,
      h.nota_exame,
      ROUND(h.horas_estudo_dia / NULLIF(h.tempo_telas_horas, 0), 3) AS indice_qualidade_digital,
      ROUND(h.nota_exame / NULLIF(h.horas_estudo_dia, 0), 2) AS roi_estudo,
      ROUND((h.freq_exercicio / 7.0) * 0.5 + (h.score_saude_mental / 10.0) * 0.5, 3) AS score_resiliencia,
      datetime('now') AS _created_at
    FROM dim_habitos h;</sql>
  </transform>
  <transform>
    <name>Gravar students_grade_performance_habits</name>
    <type>TableOutput</type>
    <connection>sqlite_estudantes</connection>
    <table>students_grade_performance_habits</table>
    <truncate>Y</truncate>
    <commit>1000</commit>
  </transform>

  <transform>
    <name>Consolidar Gold Mental SQL</name>
    <type>TableInput</type>
    <connection>sqlite_estudantes</connection>
    <sql>SELECT 
      m.id_saude_mental AS id_registro_mental,
      m.id_saude_mental,
      m.genero,
      m.idade,
      m.curso,
      m.ano_estudo,
      m.cgpa_texto,
      m.cgpa_num,
      m.depressao_flag,
      m.ansiedade_flag,
      m.ataque_panico_flag,
      m.busca_tratamento_flag,
      (m.depressao_flag + m.ansiedade_flag + m.ataque_panico_flag) AS total_condicoes,
      CASE 
        WHEN (m.depressao_flag + m.ansiedade_flag + m.ataque_panico_flag) &gt;= 2 THEN 'Alta Vulnerabilidade'
        WHEN (m.depressao_flag + m.ansiedade_flag + m.ataque_panico_flag) = 1 THEN 'Moderada Vulnerabilidade'
        ELSE 'Estável'
      END AS status_vulnerabilidade,
      datetime('now') AS _created_at
    FROM dim_saude_mental m;</sql>
  </transform>
  <transform>
    <name>Gravar students_grade_performance_mental_health</name>
    <type>TableOutput</type>
    <connection>sqlite_estudantes</connection>
    <table>students_grade_performance_mental_health</table>
    <truncate>Y</truncate>
    <commit>1000</commit>
  </transform>
</pipeline>
