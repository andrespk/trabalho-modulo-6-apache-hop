<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>03_consolidacao_gold</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Consolidacao das 3 Tabelas Gold Normalizadas</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
  </info>
  <order>
    <hop>
      <from>Ler dim_alunos</from>
      <to>Stream Lookup Sono</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Stream Lookup Sono</from>
      <to>Gravar students_grade_performance_sleep</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Ler dim_alunos</name>
    <type>TableInput</type>
    <connection>sqlite_estudantes</connection>
    <sql>SELECT * FROM dim_alunos;</sql>
  </transform>
  <transform>
    <name>Stream Lookup Sono</name>
    <type>StreamLookup</type>
  </transform>
  <transform>
    <name>Gravar students_grade_performance_sleep</name>
    <type>TableOutput</type>
    <connection>sqlite_estudantes</connection>
    <table>students_grade_performance_sleep</table>
    <truncate>Y</truncate>
    <commit>1000</commit>
  </transform>
</pipeline>
