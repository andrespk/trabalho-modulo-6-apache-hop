<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>06_indicadores_kpi</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Calculo Platinum dos KPIs Multidimensionais</description>
    <pipeline_type>Normal</pipeline_type>
  </info>
  <order>
    <hop><from>Carregar Base Consolidada</from><to>Calcular Metricas Platinum</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Carregar Base Consolidada</name>
    <type>TableInput</type>
    <connection>sqlite_estudantes</connection>
    <sql>SELECT COUNT(*) as total FROM kpi_resumo</sql>
  </transform>
  <transform>
    <name>Calcular Metricas Platinum</name>
    <type>Dummy</type>
  </transform>
</pipeline>
