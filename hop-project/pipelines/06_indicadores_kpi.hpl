<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>06_indicadores_kpi</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Calculo consolidado de KPIs para o Dashboard Metabase</description>
    <pipeline_type>Normal</pipeline_type>
  </info>
  <order>
    <hop><from>Carregar Tabelas Consolidadas</from><to>Calcular Metricas e Agregacoes</to><enabled>Y</enabled></hop>
    <hop><from>Calcular Metricas e Agregacoes</from><to>Gravar kpi_resumo SQLite</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Carregar Tabelas Consolidadas</name>
    <type>TableInput</type>
    <connection>sqlite_estudantes</connection>
    <sql>SELECT * FROM students_performance_sleep</sql>
  </transform>
  <transform><name>Calcular Metricas e Agregacoes</name><type>MemoryGroupBy</type></transform>
  <transform>
    <name>Gravar kpi_resumo SQLite</name>
    <type>TableOutput</type>
    <connection>sqlite_estudantes</connection>
    <table>kpi_resumo</table><truncate>Y</truncate>
  </transform>
</pipeline>
