<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>02_ingestao_alunos</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Transformação e Carga Silver da Dimensão de Alunos</description>
    <pipeline_type>Normal</pipeline_type>
  </info>
  <order>
    <hop><from>Ler raw_student_performance</from><to>Gravar dim_alunos SQLite</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Ler raw_student_performance</name>
    <type>TableInput</type>
    <connection>sqlite_estudantes</connection>
    <sql>SELECT student_id, horas_estudo, nota_anterior, atividades_extracurriculares, horas_sono, provas_simuladas_feitas, indice_desempenho FROM raw_student_performance</sql>
  </transform>
  <transform>
    <name>Gravar dim_alunos SQLite</name>
    <type>TableOutput</type>
    <connection>sqlite_estudantes</connection>
    <table>dim_alunos</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <specify_fields>Y</specify_fields>
    <fields>
      <field><column_name>student_id</column_name><stream_name>student_id</stream_name></field>
      <field><column_name>horas_estudo</column_name><stream_name>horas_estudo</stream_name></field>
      <field><column_name>nota_anterior</column_name><stream_name>nota_anterior</stream_name></field>
      <field><column_name>atividades_extracurriculares</column_name><stream_name>atividades_extracurriculares</stream_name></field>
      <field><column_name>horas_sono</column_name><stream_name>horas_sono</stream_name></field>
      <field><column_name>provas_simuladas_feitas</column_name><stream_name>provas_simuladas_feitas</stream_name></field>
      <field><column_name>indice_desempenho</column_name><stream_name>indice_desempenho</stream_name></field>
    </fields>
  </transform>
</pipeline>
