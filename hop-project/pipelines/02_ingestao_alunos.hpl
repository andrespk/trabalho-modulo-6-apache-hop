<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>02_ingestao_alunos</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Pipeline de ingestao e tratamento dos dados de alunos</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/26 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/26 12:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop>
      <from>Ler CSV Student_Performance</from>
      <to>Padronizar e Mapear Campos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Padronizar e Mapear Campos</from>
      <to>Classificar Desempenho e Sono</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Classificar Desempenho e Sono</from>
      <to>Gravar dim_alunos SQLite</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Ler CSV Student_Performance</name>
    <type>CSVFileInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <filename>${PROJECT_HOME}/../database/student_performance_dataset-selected-columns.csv</filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field><name>student_id</name><type>Integer</type><format>#</format></field>
      <field><name>gender</name><type>String</type><format/></field>
      <field><name>study_time_hours</name><type>Number</type><format>#.#</format></field>
      <field><name>attendance_percent</name><type>Number</type><format>#.#</format></field>
      <field><name>sleep_hours</name><type>Number</type><format>#.#</format></field>
      <field><name>parental_education</name><type>String</type><format/></field>
      <field><name>internet_access</name><type>String</type><format/></field>
      <field><name>extracurricular_activities</name><type>String</type><format/></field>
      <field><name>part_time_job</name><type>String</type><format/></field>
      <field><name>previous_grade</name><type>Number</type><format>#.#</format></field>
    </fields>
    <attributes/>
  </transform>
  <transform>
    <name>Padronizar e Mapear Campos</name>
    <type>ValueMeta</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <name>Classificar Desempenho e Sono</name>
    <type>Calculator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <name>Gravar dim_alunos SQLite</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>sqlite_estudantes</connection>
    <schema/>
    <table>dim_alunos</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <attributes/>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>
