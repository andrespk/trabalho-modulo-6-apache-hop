<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>04_calculo_platinum_kpis</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Calculo de KPIs Multidimensionais via Memory Group By</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
  </info>
  <order>
    <hop>
      <from>Ler Gold Habits</from>
      <to>Memory Group By Idade</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Memory Group By Idade</from>
      <to>Gravar kpi_faixa_etaria_performance</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ler Gold Habits</from>
      <to>Memory Group By Habitos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Memory Group By Habitos</from>
      <to>Gravar kpi_habitos_vida_performance</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Ler Gold Habits</name>
    <type>TableInput</type>
    <connection>sqlite_estudantes</connection>
    <sql>SELECT * FROM students_grade_performance_habits;</sql>
  </transform>
  <transform>
    <name>Memory Group By Idade</name>
    <type>MemoryGroupBy</type>
  </transform>
  <transform>
    <name>Gravar kpi_faixa_etaria_performance</name>
    <type>TableOutput</type>
    <connection>sqlite_estudantes</connection>
    <table>kpi_faixa_etaria_performance</table>
    <truncate>Y</truncate>
    <commit>1000</commit>
  </transform>
  <transform>
    <name>Memory Group By Habitos</name>
    <type>MemoryGroupBy</type>
  </transform>
  <transform>
    <name>Gravar kpi_habitos_vida_performance</name>
    <type>TableOutput</type>
    <connection>sqlite_estudantes</connection>
    <table>kpi_habitos_vida_performance</table>
    <truncate>Y</truncate>
    <commit>1000</commit>
  </transform>
</pipeline>
