<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>orquestrador_principal</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Workflow orquestrador principal do ETL com download HTTPS e consolidacao de 3 tabelas</description>
  <workflow_version>2.0</workflow_version>
  <actions>
    <action><name>Start</name><type>SPECIAL</type><parallel>N</parallel><xloc>50</xloc><yloc>100</yloc></action>
    <action><name>00_download_datasets_https.hpl</name><type>PIPELINE</type><filename>${PROJECT_HOME}/pipelines/00_download_datasets_https.hpl</filename><run_configuration>local</run_configuration><parallel>N</parallel><xloc>180</xloc><yloc>100</yloc></action>
    <action><name>01_ingestao_sono.hpl</name><type>PIPELINE</type><filename>${PROJECT_HOME}/pipelines/01_ingestao_sono.hpl</filename><run_configuration>local</run_configuration><parallel>N</parallel><xloc>320</xloc><yloc>100</yloc></action>
    <action><name>02_ingestao_alunos.hpl</name><type>PIPELINE</type><filename>${PROJECT_HOME}/pipelines/02_ingestao_alunos.hpl</filename><run_configuration>local</run_configuration><parallel>N</parallel><xloc>460</xloc><yloc>100</yloc></action>
    <action><name>03_ingestao_habitos.hpl</name><type>PIPELINE</type><filename>${PROJECT_HOME}/pipelines/03_ingestao_habitos.hpl</filename><run_configuration>local</run_configuration><parallel>N</parallel><xloc>600</xloc><yloc>100</yloc></action>
    <action><name>04_ingestao_saude_mental.hpl</name><type>PIPELINE</type><filename>${PROJECT_HOME}/pipelines/04_ingestao_saude_mental.hpl</filename><run_configuration>local</run_configuration><parallel>N</parallel><xloc>740</xloc><yloc>100</yloc></action>
    <action><name>05_consolidacao_tabelas.hpl</name><type>PIPELINE</type><filename>${PROJECT_HOME}/pipelines/05_consolidacao_tabelas.hpl</filename><run_configuration>local</run_configuration><parallel>N</parallel><xloc>880</xloc><yloc>100</yloc></action>
    <action><name>06_indicadores_kpi.hpl</name><type>PIPELINE</type><filename>${PROJECT_HOME}/pipelines/06_indicadores_kpi.hpl</filename><run_configuration>local</run_configuration><parallel>N</parallel><xloc>1020</xloc><yloc>100</yloc></action>
    <action><name>Success</name><type>SUCCESS</type><parallel>N</parallel><xloc>1150</xloc><yloc>100</yloc></action>
  </actions>
  <hops>
    <hop><from>Start</from><to>00_download_datasets_https.hpl</to><enabled>Y</enabled><unconditional>Y</unconditional></hop>
    <hop><from>00_download_datasets_https.hpl</from><to>01_ingestao_sono.hpl</to><enabled>Y</enabled><unconditional>N</unconditional></hop>
    <hop><from>01_ingestao_sono.hpl</from><to>02_ingestao_alunos.hpl</to><enabled>Y</enabled><unconditional>N</unconditional></hop>
    <hop><from>02_ingestao_alunos.hpl</from><to>03_ingestao_habitos.hpl</to><enabled>Y</enabled><unconditional>N</unconditional></hop>
    <hop><from>03_ingestao_habitos.hpl</from><to>04_ingestao_saude_mental.hpl</to><enabled>Y</enabled><unconditional>N</unconditional></hop>
    <hop><from>04_ingestao_saude_mental.hpl</from><to>05_consolidacao_tabelas.hpl</to><enabled>Y</enabled><unconditional>N</unconditional></hop>
    <hop><from>05_consolidacao_tabelas.hpl</from><to>06_indicadores_kpi.hpl</to><enabled>Y</enabled><unconditional>N</unconditional></hop>
    <hop><from>06_indicadores_kpi.hpl</from><to>Success</to><enabled>Y</enabled><unconditional>N</unconditional></hop>
  </hops>
</workflow>
