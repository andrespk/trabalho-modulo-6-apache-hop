<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>orquestrador_principal</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Workflow Master Modular - Engenharia de Dados Apache Hop 2.5</description>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/08/26 12:00:00.000</created_date>
  <modified_date>2026/08/26 12:00:00.000</modified_date>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>112</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql>SELECT 1;</sql>
      <connection>sqlite_estudantes</connection>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>Y</sendOneStatement>
      <name>00_Init_Schema_SQL</name>
      <description>Cria schema DDL idempotente com 20 tabelas e indices</description>
      <type>SQL</type>
      <attributes/>
      <xloc>260</xloc>
      <yloc>120</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/pipelines/01_raw_staging.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>N</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>01_Ingestao_Bronze_Ref</name>
      <description>Executa pipeline nativa de ingestao Raw e Reference</description>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>480</xloc>
      <yloc>112</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql>
        SELECT COUNT(*) FROM raw_sleep_efficiency;
        SELECT COUNT(*) FROM raw_student_habits;
        SELECT COUNT(*) FROM raw_student_mental_health;
      </sql>
      <connection>sqlite_estudantes</connection>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>N</sendOneStatement>
      <name>02_Validar_Contagens_Integridade_SQL</name>
      <description>Valida contagens e integridade nas tabelas processadas</description>
      <type>SQL</type>
      <attributes/>
      <xloc>740</xloc>
      <yloc>120</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <message>Falha na execucao da esteira ETL. Verifique os logs detalhados.</message>
      <loglevel>Error</loglevel>
      <name>Tratamento_Erro_Abort</name>
      <description>Aborta execucao caso ocorra falha em qualquer etapa</description>
      <type>ABORT</type>
      <attributes/>
      <xloc>480</xloc>
      <yloc>280</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>00_Init_Schema_SQL</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>00_Init_Schema_SQL</from>
      <to>01_Ingestao_Bronze_Ref</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>01_Ingestao_Bronze_Ref</from>
      <to>02_Validar_Contagens_Integridade_SQL</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>00_Init_Schema_SQL</from>
      <to>Tratamento_Erro_Abort</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>01_Ingestao_Bronze_Ref</from>
      <to>Tratamento_Erro_Abort</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>02_Validar_Contagens_Integridade_SQL</from>
      <to>Tratamento_Erro_Abort</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>
